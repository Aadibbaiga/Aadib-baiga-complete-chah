<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>My Portfolio</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      background: #f5f7fb;
      color: #222;
    }

    /* Navbar */
    nav {
      position: fixed;
      top: 0;
      width: 100%;
      background: #111827;
      padding: 15px 8%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 1000;
    }

    nav h2 {
      color: white;
    }

    nav ul {
      list-style: none;
      display: flex;
      gap: 20px;
    }

    nav ul li a {
      color: white;
      text-decoration: none;
      font-weight: bold;
    }

    nav ul li a:hover {
      color: #38bdf8;
    }

    /* Hero */
    .hero {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 100px 20px 50px;
      background: linear-gradient(135deg, #0f172a, #1e3a8a);
      color: white;
    }

    .hero h1 {
      font-size: 50px;
      margin-bottom: 15px;
    }

    .hero span {
      color: #38bdf8;
    }

    .hero p {
      font-size: 20px;
      margin-bottom: 25px;
    }

    .btn {
      display: inline-block;
      padding: 12px 25px;
      background: #38bdf8;
      color: #111827;
      text-decoration: none;
      border-radius: 8px;
      font-weight: bold;
    }

    .btn:hover {
      background: white;
    }

    /* Sections */
    section {
      padding: 80px 8%;
    }

    section h2 {
      text-align: center;
      font-size: 35px;
      margin-bottom: 40px;
    }

    /* About */
    .about {
      max-width: 800px;
      margin: auto;
      text-align: center;
      font-size: 18px;
    }

    /* Skills */
    .skills {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 20px;
    }

    .skill {
      background: white;
      padding: 25px;
      width: 180px;
      text-align: center;
      border-radius: 12px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.1);
      font-weight: bold;
    }

    /* Projects */
    .projects {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 25px;
    }

    .project {
      background: white;
      padding: 25px;
      border-radius: 12px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    }

    .project h3 {
      margin-bottom: 10px;
      color: #1e3a8a;
    }

    /* Contact */
    .contact {
      text-align: center;
    }

    .contact p {
      margin: 10px;
      font-size: 18px;
    }

    /* Footer */
    footer {
      background: #111827;
      color: white;
      text-align: center;
      padding: 20px;
    }

    /* Mobile */
    @media (max-width: 600px) {
      nav {
        padding: 15px 5%;
      }

      nav ul {
        gap: 10px;
      }

      nav ul li a {
        font-size: 13px;
      }

      .hero h1 {
        font-size: 38px;
      }

      .hero p {
        font-size: 17px;
      }
    }
  </style>
</head>

<body>

  <!-- Navigation -->
  <nav>
    <h2>My Portfolio</h2>

    <ul>
      <li><a href="#home">Home</a></li>
      <li><a href="#about">About</a></li>
      <li><a href="#skills">Skills</a></li>
      <li><a href="#projects">Projects</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul>
  </nav>


  <!-- Home -->
  <section class="hero" id="home">
    <div>
      <h1>Hello, I'm <span>Your Name</span></h1>

      <p>Web Developer | Designer | Learner</p>

      <a href="#contact" class="btn">Contact Me</a>
    </div>
  </section>


  <!-- About -->
  <section id="about">
    <h2>About Me</h2>

    <div class="about">
      <p>
        Hello! My name is Your Name.
        I am learning web development and I love creating
        modern and useful websites. I enjoy learning new
        technologies and building creative projects.
      </p>
    </div>
  </section>


  <!-- Skills -->
  <section id="skills">
    <h2>My Skills</h2>

    <div class="skills">

      <div class="skill">HTML</div>

      <div class="skill">CSS</div>

      <div class="skill">JavaScript</div>

      <div class="skill">GitHub</div>

      <div class="skill">Web Design</div>

    </div>
  </section>


  <!-- Projects -->
  <section id="projects">
    <h2>My Projects</h2>

    <div class="projects">

      <div class="project">
        <h3>Portfolio Website</h3>
        <p>
          A modern personal portfolio website
          created using HTML and CSS.
        </p>
      </div>

      <div class="project">
        <h3>Gram Bazaar</h3>
        <p>
          A local marketplace website where
          village products can be displayed and sold online.
        </p>
      </div>

      <div class="project">
        <h3>Motivation Website</h3>
        <p>
          A simple website containing motivational
          quotes and study motivation.
        </p>
      </div>

    </div>
  </section>


  <!-- Contact -->
  <section id="contact">
    <h2>Contact Me</h2>

    <div class="contact">

      <p>📧 Email: your@email.com</p>

      <p>📱 Phone: +91 XXXXX XXXXX</p>

      <p>📍 India</p>

    </div>
  </section>


  <!-- Footer -->
  <footer>
    <p>© 2026 Your Name. All Rights Reserved.</p>
  </footer>

</body>
</html>
